{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Open Verilog",
  "scopeName": "source.ov",
  "fileTypes": [
    "ov"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#preprocessor"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#contextual"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#names"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ov",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ov",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ov",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ov",
              "match": "\\\\."
            },
            {
              "name": "constant.other.placeholder.ov",
              "match": "%[-+0# ]*\\d*(?:\\.\\d+)?[a-zA-Z%]"
            }
          ]
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "meta.preprocessor.ov",
          "match": "\\`[A-Za-z_][A-Za-z0-9_$]*"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.based.ov",
          "match": "\\b\\d[\\d_]*\\s*'[sS]?[bBoOdDhH]\\s*[0-9a-fA-F_xXzZ?]+"
        },
        {
          "name": "constant.numeric.based.ov",
          "match": "(?<![\\w'])'[sS]?[bBoOdDhH]\\s*[0-9a-fA-F_xXzZ?]+"
        },
        {
          "name": "constant.numeric.based.ov",
          "match": "(?<![\\w'])'[01xXzZ]\\b"
        },
        {
          "name": "constant.numeric.float.ov",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*(?:[eE][-+]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.ov",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(module|pipeline|interface|package|program|bundle|trait|config|isa|regmap|memmap|struct|enum|union|typedef|class)\\s+([A-Za-z_][A-Za-z0-9_$]*)",
          "captures": {
            "1": {
              "name": "storage.type.declaration.ov"
            },
            "2": {
              "name": "entity.name.type.ov"
            }
          }
        },
        {
          "match": "\\b(probe)\\s+([A-Za-z_][A-Za-z0-9_$]*)\\s+(on)\\s+([A-Za-z_][A-Za-z0-9_$]*)(?:\\s+(when)\\b)?",
          "captures": {
            "1": {
              "name": "storage.type.declaration.ov"
            },
            "2": {
              "name": "entity.name.function.ov"
            },
            "3": {
              "name": "keyword.other.ov"
            },
            "4": {
              "name": "entity.name.type.ov"
            },
            "5": {
              "name": "keyword.other.ov"
            }
          }
        },
        {
          "match": "\\b(fn|function|task)\\s+([A-Za-z_][A-Za-z0-9_$]*)",
          "captures": {
            "1": {
              "name": "storage.type.declaration.ov"
            },
            "2": {
              "name": "entity.name.function.ov"
            }
          }
        },
        {
          "match": "\\b(stage|fsm)\\s+([A-Za-z_][A-Za-z0-9_$]*)",
          "captures": {
            "1": {
              "name": "storage.type.declaration.ov"
            },
            "2": {
              "name": "entity.name.section.ov"
            }
          }
        },
        {
          "match": "\\b(extends|implements|like)\\s+([A-Za-z_][A-Za-z0-9_$]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.ov"
            },
            "2": {
              "name": "entity.name.type.ov"
            }
          }
        },
        {
          "match": "\\b(val|const|localparam|parameter)\\s+([A-Za-z_][A-Za-z0-9_$]*)",
          "captures": {
            "1": {
              "name": "storage.type.declaration.ov"
            },
            "2": {
              "name": "variable.other.constant.ov"
            }
          }
        },
        {
          "match": "\\b(test)\\b(?=\\s+[\"A-Za-z_])",
          "name": "storage.type.declaration.ov"
        }
      ]
    },
    "contextual": {
      "patterns": [
        {
          "match": "\\b(for)\\s+([A-Za-z_][A-Za-z0-9_$]*)\\s+(in)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.ov"
            },
            "2": {
              "name": "variable.other.ov"
            },
            "3": {
              "name": "keyword.control.ov"
            }
          }
        },
        {
          "name": "keyword.other.ov",
          "match": "\\b(?:size|irq|opcode|max|timeout|limit)\\b(?=\\s+['\"\\d])"
        },
        {
          "name": "keyword.other.ov",
          "match": "\\b(?:from|compatible|dt)\\b(?=\\s+\")"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ov",
          "match": "\\b(?:if|else|for|foreach|while|do|repeat|forever|case|casex|casez|endcase|default|return|break|continue|match|goto|wait|fork|join|join_any|join_none|disable|unique|unique0|priority|iff|inside|begin|end)\\b"
        },
        {
          "name": "storage.type.declaration.ov",
          "match": "\\b(?:module|endmodule|pipeline|stage|interface|endinterface|package|endpackage|program|endprogram|bundle|trait|config|isa|regmap|memmap|fsm|fn|function|endfunction|task|endtask|struct|enum|union|typedef|class|endclass|extends|implements|import|export|generate|endgenerate|genvar|val|const|localparam|parameter|probe|test|modport|clocking|endclocking|property|endproperty|sequence|endsequence|assert|assume|cover|initial|always|always_ff|always_comb|always_latch|assign|override|same_domain)\\b"
        },
        {
          "name": "storage.type.ov",
          "match": "\\b(?:logic|reg|wire|bit|byte|int|integer|longint|shortint|real|shortreal|realtime|time|string|event|void|chandle|tri|tri0|tri1|supply0|supply1|wand|wor)\\b"
        },
        {
          "name": "storage.modifier.ov",
          "match": "\\b(?:input|output|inout|ref|master|slave|monitor|async|sync|strobe|signed|unsigned|packed|var|automatic|static|virtual|local|protected|rand|randc)\\b"
        },
        {
          "name": "keyword.other.ov",
          "match": "\\b(?:stall_when|flush_when|kill_when|younger_when|tie_off|reset|clock|posedge|negedge|edge)\\b"
        },
        {
          "name": "constant.language.ov",
          "match": "\\b(?:true|false|null)\\b"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "support.function.system.ov",
          "match": "\\$[A-Za-z_][A-Za-z0-9_$]*"
        },
        {
          "match": "(?<![\\w)\\]])(\\.)([A-Za-z_][A-Za-z0-9_$]*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.ov"
            },
            "2": {
              "name": "variable.parameter.port.ov"
            }
          }
        },
        {
          "match": "(\\.)\\s*(wrap|fire|zext|sext|fill|delay|list|map|reduce|tree_reduce|fold|filter|select|enumerate|reverse|len|msb|lsb|as)\\b(?=\\s*[(\\s;,)\\]\\[]|$)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.ov"
            },
            "2": {
              "name": "support.function.builtin.ov"
            }
          }
        },
        {
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_$]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "punctuation.accessor.ov"
            },
            "2": {
              "name": "entity.name.function.ov"
            }
          }
        },
        {
          "match": "\\b([A-Z][A-Za-z0-9_]*[a-z][A-Za-z0-9_]*)\\s+([A-Za-z_][A-Za-z0-9_$]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.type.ov"
            },
            "2": {
              "name": "variable.other.instance.ov"
            }
          }
        },
        {
          "match": "(?<=\\S)(>)\\s+([A-Za-z_][A-Za-z0-9_$]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "keyword.operator.ov"
            },
            "2": {
              "name": "variable.other.instance.ov"
            }
          }
        },
        {
          "name": "support.function.builtin.ov",
          "match": "\\b(?:clog2|min|max|abs|isqrt)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.test.ov",
          "match": "\\b(?:step|expect|wait_until|send|recv|print)\\b(?=\\s*[(;])"
        },
        {
          "name": "entity.name.function.ov",
          "match": "\\b[A-Za-z_][A-Za-z0-9_$]*(?=\\s*\\()"
        }
      ]
    },
    "names": {
      "patterns": [
        {
          "name": "variable.other.constant.ov",
          "match": "\\b[A-Z][A-Z0-9_]*\\b"
        },
        {
          "name": "entity.name.type.ov",
          "match": "\\b[A-Z][A-Za-z0-9_]*[a-z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.range.ov",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.concat.ov",
          "match": "\\+\\+"
        },
        {
          "name": "keyword.operator.arrow.ov",
          "match": "=>|->"
        },
        {
          "name": "keyword.operator.ov",
          "match": "<<<|>>>|<<|>>|<=|>=|===|!==|==|!=|&&|\\|\\||[-+*/%&|^~!<>=?:]"
        },
        {
          "name": "punctuation.separator.ov",
          "match": "[;,]"
        },
        {
          "name": "punctuation.definition.ov",
          "match": "[@#]"
        }
      ]
    }
  }
}
